{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Stand O'Food game data",
    "type": "object",
    "additionalProperties": false,
    "required": ["customers", "groups", "slices", "devices", "ingredients", "sandwiches", "levels", "rush_levels"],
    "properties": {
        "customers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["biznesman", "bizneswoman", "chudak", "fatman", "gangster", "glamour", "hippi", "sportsman", "stroitel", "tourist"],
            "properties": {
                "biznesman": { "$ref": "#/$defs/customer" },
                "bizneswoman": { "$ref": "#/$defs/customer" },
                "chudak": { "$ref": "#/$defs/customer" },
                "fatman": { "$ref": "#/$defs/customer" },
                "gangster": { "$ref": "#/$defs/customer" },
                "glamour": { "$ref": "#/$defs/customer" },
                "hippi": { "$ref": "#/$defs/customer" },
                "sportsman": { "$ref": "#/$defs/customer" },
                "stroitel": { "$ref": "#/$defs/customer" },
                "tourist": { "$ref": "#/$defs/customer" }
            }
        },
        "groups": {
            "type": "array",
            "items": { "$ref": "#/$defs/group" }
        },
        "slices": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "BreadBottom",
                "BreadTop",
                "BeefPatty",
                "Bacon",
                "Chicken",
                "FishCake",
                "Pickles",
                "Tomato",
                "Lettuce",
                "Cheese",
                "Onion",
                "Egg"
            ],
            "properties": {
                "BreadBottom": { "type": "integer", "minimum": 0 },
                "BreadTop": { "type": "integer", "minimum": 0 },
                "BeefPatty": { "type": "integer", "minimum": 0 },
                "Bacon": { "type": "integer", "minimum": 0 },
                "Chicken": { "type": "integer", "minimum": 0 },
                "FishCake": { "type": "integer", "minimum": 0 },
                "Pickles": { "type": "integer", "minimum": 0 },
                "Tomato": { "type": "integer", "minimum": 0 },
                "Lettuce": { "type": "integer", "minimum": 0 },
                "Cheese": { "type": "integer", "minimum": 0 },
                "Onion": { "type": "integer", "minimum": 0 },
                "Egg": { "type": "integer", "minimum": 0 }
            }
        },
        "devices": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Coffee Machine", "Plate", "Conditioner", "Heater", "Packing", "Jukebox"],
            "properties": {
                "Coffee Machine": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1", "cost2", "cost3"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 },
                        "cost2": { "type": "integer", "minimum": 0 },
                        "cost3": { "type": "integer", "minimum": 0 }
                    }
                },
                "Plate": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 }
                    }
                },
                "Conditioner": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1", "cost2", "cost3"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 },
                        "cost2": { "type": "integer", "minimum": 0 },
                        "cost3": { "type": "integer", "minimum": 0 }
                    }
                },
                "Heater": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1", "cost2", "cost3"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 },
                        "cost2": { "type": "integer", "minimum": 0 },
                        "cost3": { "type": "integer", "minimum": 0 }
                    }
                },
                "Packing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 }
                    }
                },
                "Jukebox": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cost1", "cost2", "cost3"],
                    "properties": {
                        "cost1": { "type": "integer", "minimum": 0 },
                        "cost2": { "type": "integer", "minimum": 0 },
                        "cost3": { "type": "integer", "minimum": 0 }
                    }
                }
            }
        },
        "ingredients": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Ketchup", "Curry", "Tartar Sauce", "Mayonnaise", "Tabasco", "Secret Spices"],
            "properties": {
                "Ketchup": { "$ref": "#/$defs/ingredient" },
                "Curry": { "$ref": "#/$defs/ingredient" },
                "Tartar Sauce": { "$ref": "#/$defs/ingredient" },
                "Mayonnaise": { "$ref": "#/$defs/ingredient" },
                "Tabasco": { "$ref": "#/$defs/ingredient" },
                "Secret Spices": { "$ref": "#/$defs/ingredient" }
            }
        },
        "sandwiches": {
            "type": "array",
            "items": { "$ref": "#/$defs/sandwich" }
        },
        "levels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "Stand o' Breakfast",
                "Snack Shack",
                "Burger Bar",
                "Butch's",
                "Chicken House",
                "Omelet Stand",
                "Morning Cafe",
                "Stand o' Cheese",
                "Stand o' Beef",
                "Stand o' Leaf",
                "Stand o' Veggies",
                "Cheese Heaven",
                "Vegetarian Paradise",
                "Cafe Mix",
                "Big Breakfast",
                "Fatty's",
                "Donald's",
                "Fairy's",
                "Highway Stop",
                "Sunrise Stop",
                "Your Heart's Desire",
                "Egg and Chick",
                "Beef and Cheese",
                "Veggie Buffet",
                "The Salad Princess",
                "The Hen-House",
                "Variety Buffet",
                "Burger Joint",
                "Double Trouble",
                "Fast Buck's",
                "Seafood Lover's Buffet",
                "Rich and Greasy",
                "Crossroads",
                "McMaster's",
                "Complicated Burgers",
                "Easy Burgers",
                "Strange but Tasty",
                "Delicious Cafe",
                "Exotic Cuisine",
                "Business Lunch",
                "Burger Megabar",
                "The Only 24h",
                "City Shopping Mall",
                "Champion's"
            ],
            "properties": {
                "Stand o' Breakfast": { "$ref": "#/$defs/bistro" },
                "Snack Shack": { "$ref": "#/$defs/bistro" },
                "Burger Bar": { "$ref": "#/$defs/bistro" },
                "Butch's": { "$ref": "#/$defs/bistro" },
                "Chicken House": { "$ref": "#/$defs/bistro" },
                "Omelet Stand": { "$ref": "#/$defs/bistro" },
                "Morning Cafe": { "$ref": "#/$defs/bistro" },
                "Stand o' Cheese": { "$ref": "#/$defs/bistro" },
                "Stand o' Beef": { "$ref": "#/$defs/bistro" },
                "Stand o' Leaf": { "$ref": "#/$defs/bistro" },
                "Stand o' Veggies": { "$ref": "#/$defs/bistro" },
                "Cheese Heaven": { "$ref": "#/$defs/bistro" },
                "Vegetarian Paradise": { "$ref": "#/$defs/bistro" },
                "Cafe Mix": { "$ref": "#/$defs/bistro" },
                "Big Breakfast": { "$ref": "#/$defs/bistro" },
                "Fatty's": { "$ref": "#/$defs/bistro" },
                "Donald's": { "$ref": "#/$defs/bistro" },
                "Fairy's": { "$ref": "#/$defs/bistro" },
                "Highway Stop": { "$ref": "#/$defs/bistro" },
                "Sunrise Stop": { "$ref": "#/$defs/bistro" },
                "Your Heart's Desire": { "$ref": "#/$defs/bistro" },
                "Egg and Chick": { "$ref": "#/$defs/bistro" },
                "Beef and Cheese": { "$ref": "#/$defs/bistro" },
                "Veggie Buffet": { "$ref": "#/$defs/bistro" },
                "The Salad Princess": { "$ref": "#/$defs/bistro" },
                "The Hen-House": { "$ref": "#/$defs/bistro" },
                "Variety Buffet": { "$ref": "#/$defs/bistro" },
                "Burger Joint": { "$ref": "#/$defs/bistro" },
                "Double Trouble": { "$ref": "#/$defs/bistro" },
                "Fast Buck's": { "$ref": "#/$defs/bistro" },
                "Seafood Lover's Buffet": { "$ref": "#/$defs/bistro" },
                "Rich and Greasy": { "$ref": "#/$defs/bistro" },
                "Crossroads": { "$ref": "#/$defs/bistro" },
                "McMaster's": { "$ref": "#/$defs/bistro" },
                "Complicated Burgers": { "$ref": "#/$defs/bistro" },
                "Easy Burgers": { "$ref": "#/$defs/bistro" },
                "Strange but Tasty": { "$ref": "#/$defs/bistro" },
                "Delicious Cafe": { "$ref": "#/$defs/bistro" },
                "Exotic Cuisine": { "$ref": "#/$defs/bistro" },
                "Business Lunch": { "$ref": "#/$defs/bistro" },
                "Burger Megabar": { "$ref": "#/$defs/bistro" },
                "The Only 24h": { "$ref": "#/$defs/bistro" },
                "City Shopping Mall": { "$ref": "#/$defs/bistro" },
                "Champion's": { "$ref": "#/$defs/bistro" }
            }
        },
        "rush_levels": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/rushLevel" }
        }
    },
    "$defs": {
        "customerName": {
            "enum": ["biznesman", "bizneswoman", "chudak", "fatman", "gangster", "glamour", "hippi", "sportsman", "stroitel", "tourist"]
        },
        "groupName": {
            "enum": ["all", "secret", "rich", "poor", "normal", "fat", "health", "biznes", "morning"]
        },
        "sliceName": {
            "enum": [
                "BreadBottom",
                "BreadTop",
                "BeefPatty",
                "Bacon",
                "Chicken",
                "FishCake",
                "Pickles",
                "Tomato",
                "Lettuce",
                "Cheese",
                "Onion",
                "Egg"
            ]
        },
        "customer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "gratuity_percent": { "type": "number", "minimum": 0 },
                "gratuity": { "type": "integer", "minimum": 0 },
                "wait_time": { "type": "integer", "minimum": 0 },
                "wait_tips_percent": { "type": "number", "minimum": 0 }
            }
        },
        "group": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "customers"],
            "properties": {
                "name": { "$ref": "#/$defs/groupName" },
                "customers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/customerName" }
                }
            }
        },
        "ingredient": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cost", "slices"],
            "properties": {
                "cost": { "type": "integer", "minimum": 0 },
                "slices": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/ingredientEffect" }
                }
            }
        },
        "ingredientEffect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": { "$ref": "#/$defs/sliceName" },
                "bonus": { "type": "integer" },
                "multiplier": { "type": "number", "minimum": 0 }
            },
            "oneOf": [
                {
                    "required": ["bonus"]
                },
                {
                    "required": ["multiplier"]
                }
            ]
        },
        "sandwich": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cost", "group", "slices"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "cost": { "type": "integer", "minimum": 0 },
                "group": { "$ref": "#/$defs/groupName" },
                "slices": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": { "$ref": "#/$defs/sliceName" }
                }
            }
        },
        "levelSandwich": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "count"],
            "properties": {
                "type": { "type": "string", "minLength": 1 },
                "count": { "type": "integer", "minimum": 1 },
                "group": { "$ref": "#/$defs/groupName" },
                "face": { "type": "integer", "minimum": 1 }
            }
        },
        "level": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lines", "score", "sandwiches"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "lines": { "type": "integer", "minimum": 1 },
                "score": { "type": "integer", "minimum": 0 },
                "sandwiches": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/levelSandwich" }
                }
            }
        },
        "bistro": {
            "type": "object",
            "additionalProperties": false,
            "required": ["score", "bonus", "levels"],
            "properties": {
                "score": { "type": "integer", "minimum": 0 },
                "bonus": { "type": "integer", "minimum": 0 },
                "levels": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/level" }
                }
            }
        },
        "rushLevel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lines", "score", "bonus", "sandwiches"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "lines": { "type": "integer", "minimum": 1 },
                "score": { "type": "integer", "minimum": 0 },
                "bonus": { "type": "integer", "minimum": 0 },
                "sandwiches": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "count"],
                        "properties": {
                            "type": { "type": "string", "minLength": 1 },
                            "count": { "type": "integer", "minimum": 1 }
                        }
                    }
                }
            }
        }
    }
}